<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<!--
  SecureTrax-2 dev Traccar config. Persists devices/positions to the same
  Postgres+TimescaleDB instance as the rest of the stack (separate database
  `traccar`). Production deployments should use a real admin password,
  enable TLS on /api, and pin device-protocol ports per hardware fleet.
-->
<properties>
  <entry key='config.default'>./conf/default.xml</entry>

  <entry key='database.driver'>org.postgresql.Driver</entry>
  <entry key='database.url'>jdbc:postgresql://postgres:5432/traccar</entry>
  <entry key='database.user'>securetrax</entry>
  <entry key='database.password'>securetrax</entry>

  <entry key='web.port'>8082</entry>
  <entry key='web.address'>0.0.0.0</entry>
</properties>
