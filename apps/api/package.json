{
  "name": "@securetrax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src --ext .ts || true"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/platform-ws": "^10.4.4",
    "@securetrax/core": "workspace:*",
    "@securetrax/module-contracts": "workspace:*",
    "@securetrax/module-ai-assistant": "workspace:*",
    "@securetrax/module-aircraft-qgc": "workspace:*",
    "@securetrax/module-reports-fleet": "workspace:*",
    "@securetrax/module-telemetry-mqtt": "workspace:*",
    "@securetrax/module-tracking-traccar": "workspace:*",
    "@securetrax/module-video-securevu": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
