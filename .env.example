# Copy to .env at the repo root and adjust per environment.

# Postgres / TimescaleDB
POSTGRES_PASSWORD=securetrax

# MinIO (object storage for clips, license artifacts)
MINIO_ROOT_USER=securetrax
MINIO_ROOT_PASSWORD=securetrax-change-me

# HashiCorp Vault (dev mode root token; use real auth in production)
VAULT_ROOT_TOKEN=securetrax-dev-root

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=securetrax
